# Postgres. `pnpm db:up` starts the container in docker-compose.yml.
DATABASE_URL="postgresql://driftwatch:driftwatch@localhost:5433/driftwatch?schema=public"
# On Neon, append "&connect_timeout=30" to both URLs: the free tier suspends
# when idle and takes longer to wake than Prisma's 5s default. See CLAUDE.md 14.
# Direct connection for schema pushes. Same as DATABASE_URL unless that goes
# through a pooler (on Neon, the host without "-pooler").
DIRECT_URL="postgresql://driftwatch:driftwatch@localhost:5433/driftwatch?schema=public"

# Where cloned spec repos are kept, and spec blobs when R2 is not configured.
DATA_DIR="./.data"

# Optional. Cloudflare R2 for spec blobs: set all three or none. Required for
# the scheduled job, whose runner disk is wiped after every run.
# R2_BASE_URL is "https://<account-id>.r2.cloudflarestorage.com/<bucket>".
R2_BASE_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Optional. Raises the GitHub API rate limit for clones of large repos.
GITHUB_TOKEN=""
