// Driftwatch — consumer-side breaking-change radar.
//
// The full model is defined up front even though only the acquisition path
// (Provider, SpecSource, SpecSnapshot) is exercised today. Diffing and the
// GitHub App land on this schema without a destructive migration.

generator client {
  provider = "prisma-client-js"
  // The site's server functions run on Netlify's AWS Lambda (Amazon Linux,
  // OpenSSL 3), not on the machine that builds them.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// DATABASE_URL may go through a connection pooler (Neon's "-pooler" host).
// Schema pushes need a session a pooler will not hold, so they use DIRECT_URL.
// Without a pooler, set both to the same value.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Tier {
  A // spec tracked in a public git repo — history is free
  B // spec at a stable hosted URL — poll it
  C // HTML changelog only — extracted, low confidence
}

enum Severity {
  BREAKING
  DEPRECATION
  BEHAVIORAL
  ADDITIVE
  COSMETIC // stored, never published; this is where the noise goes
}

enum PrState {
  DRAFTED
  OPENED
  MERGED
  CLOSED
}

// ── providers and sources ───────────────────────────────────────────────

model Provider {
  id        String   @id @default(cuid())
  slug      String   @unique // "stripe"
  name      String
  category  String? // "payments", "communications", …
  docsUrl   String?
  createdAt DateTime @default(now())

  sources   SpecSource[]
  snapshots SpecSnapshot[]
}

// One row per spec FILE, not per provider. Twilio publishes a dozen product
// specs in one repo and each drifts on its own schedule.
model SpecSource {
  id         String   @id @default(cuid())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String

  key   String // unique within the provider, e.g. "api_v2010"
  label String // human name for the feed, e.g. "Twilio Core API (2010-04-01)"

  tier Tier

  // tier A
  repo     String? // "stripe/openapi"
  ref      String? @default("HEAD")
  filePath String? // "openapi/spec3.json"

  // tier B
  url String?

  cron   String  @default("0 */6 * * *")
  active Boolean @default(true)

  // JSON Pointers stripped before hashing. Some specs embed a build stamp or
  // a rotating example value that would otherwise look like a change on
  // every single poll.
  volatilePointers String[] @default([])

  // Health, written by every poll. A source that stops fetching must never
  // go quiet: `status` and the review-queue issue flag it from these.
  lastFetchAt         DateTime? // every attempt, success or not
  lastSuccessAt       DateTime?
  lastChangeAt        DateTime? // last poll that stored a new surface
  lastError           String?
  consecutiveFailures Int       @default(0)

  // Tier B conditional requests: an unchanged spec answers 304, not megabytes.
  etag         String?
  lastModified String?

  snapshots SpecSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, key])
  @@index([tier, active])
}

// ── snapshots ───────────────────────────────────────────────────────────

model SpecSnapshot {
  id         String     @id @default(cuid())
  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  source     SpecSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String

  // sha256 of the NORMALIZED body. Two snapshots with the same hash are the
  // same API surface even if the bytes on disk differ.
  contentHash String

  rawBlobKey  String // content-addressed path under DATA_DIR/blobs
  normBlobKey String

  oasVersion String // "3.1.0"
  byteSize   Int
  pathCount  Int
  opCount    Int

  commitSha String? // tier A only

  // When the PROVIDER changed it (commit date), not when we fetched it.
  // Ordering by capturedAt would put a backfill in the wrong sequence.
  providerTime DateTime?
  capturedAt   DateTime  @default(now())

  fromRuns DiffRun[] @relation("diffFrom")
  toRuns   DiffRun[] @relation("diffTo")

  @@unique([sourceId, contentHash])
  @@index([sourceId, providerTime])
}

// ── diffing ─────────────────────────────────────────────────────────────

model DiffRun {
  id String @id @default(cuid())

  from   SpecSnapshot @relation("diffFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId String
  to     SpecSnapshot @relation("diffTo", fields: [toId], references: [id], onDelete: Cascade)
  toId   String

  engine     String // "driftwatch-core@1.0.0"
  rulesetVer String // our consumer-direction overlay version

  changes Change[]

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  // Bump rulesetVer to re-classify a pair without wiping history.
  @@unique([fromId, toId, rulesetVer])
}

model Change {
  id    String  @id @default(cuid())
  run   DiffRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  ruleId        String // "response.property.became-optional"
  severity      Severity
  confidence    Int // 0-100, gates publish
  directionFlip Boolean  @default(false)

  // Identity of the underlying FACT. One inline enum seen across nine
  // operations is nine rows sharing one fingerprint: the feed groups on this,
  // while the rows stay so the GitHub App can name each affected call site.
  fingerprint String

  // The story this fact belongs to, and its permanent public id: the
  // /changes/<storyId> URL. Derived from the release (the `to` snapshot,
  // which a re-diff never recreates) and the story key, so it survives
  // ruleset bumps, unlike row ids.
  storyId String?

  method      String?
  path        String?
  operationId String?
  jsonPointer String // "/paths/~1v1~1charges/post/responses/200/..."

  // Set when the change belongs to a shared component rather than one
  // operation, with how much of the API that component reaches.
  componentName      String?
  affectedOperations Int?
  fieldPath          String? // "customer.address"
  detail             String?

  before Json?
  after  Json?

  impact Impact?

  reviewedAt  DateTime? // when it was decided
  // Who decided: "human", or the auto-publish policy version ("auto-1").
  // Null on rows decided before the field existed, all by a person.
  reviewedBy  String?
  publishedAt DateTime?

  @@index([severity, publishedAt])
  @@index([ruleId])
  @@index([runId])
  @@index([fingerprint])
  @@index([storyId])
}

model Impact {
  id       String @id @default(cuid())
  change   Change @relation(fields: [changeId], references: [id], onDelete: Cascade)
  changeId String @unique

  headline String // one line
  body     String // markdown
  patterns Json // { ts: "...", py: "...", go: "..." }

  model         String // provenance
  editedByHuman Boolean @default(false)

  createdAt DateTime @default(now())
}

// ── paid side ───────────────────────────────────────────────────────────

model Repo {
  id             String @id @default(cuid())
  installationId String
  fullName       String @unique
  defaultBranch  String

  usages ApiUsage[]
  fixes  FixPr[]

  lastScanSha String?
  createdAt   DateTime @default(now())
}

model ApiUsage {
  id     String @id @default(cuid())
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId String

  providerId String
  method     String?
  path       String?
  fieldPath  String? // "charge.customer.address"

  file     String
  line     Int
  evidence String // the source line, quoted back in the PR body

  @@index([repoId, providerId])
  @@index([providerId, path])
}

model FixPr {
  id     String @id @default(cuid())
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId String

  changeId String
  prNumber Int?
  state    PrState @default(DRAFTED)

  createdAt DateTime  @default(now())
  mergedAt  DateTime? // the only metric that matters

  @@index([repoId, state])
}

// ── waitlist ────────────────────────────────────────────────────────────

// "Watch my repo": people who want the GitHub App to open a PR when an API
// change breaks their code. No email provider yet; nothing is sent. Stores
// only what the form asks for, and no IP address.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique // lower-cased; resubmitting updates the entry
  repoUrl   String // https://github.com/<owner>/<repo>
  apis      String[] // provider slugs
  otherApis String? // free text for APIs not watched yet
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── share kit ───────────────────────────────────────────────────────────

// Draft posts for a published breaking change, one row per story. A person
// posts them by hand (`pnpm w share`); nothing posts automatically.
model ShareDraft {
  id           String    @id @default(cuid())
  storyId      String    @unique // /changes/<storyId>
  providerSlug String
  shippedAt    DateTime
  xPost        String // fits X's 280 characters
  title        String // fits Hacker News's 80
  body         String // HN or Reddit
  createdAt    DateTime  @default(now())
  postedAt     DateTime? // marked by hand after posting
  skippedAt    DateTime? // marked by hand: not worth posting

  @@index([postedAt, skippedAt])
}

// ── signals ─────────────────────────────────────────────────────────────

// Feed requests that reached the site (not Netlify's CDN), per day and path.
// A lower bound on real fetches: the CDN answers repeats within 5 minutes.
// The free Netlify plan exposes no logs, so this is the approximation.
model FeedFetch {
  day   String // YYYY-MM-DD, UTC
  path  String // "/rss.xml", "/apis/stripe/feed.json"
  count Int    @default(0)

  @@id([day, path])
}
