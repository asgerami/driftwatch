{
  "name": "@driftwatch/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:cf": "NODE_OPTIONS='--import ./scripts/wasm-module-hooks.mjs' opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render-check": "tsx --tsconfig tsconfig.scripts.json scripts/render-check.tsx",
    "test": "tsx --tsconfig tsconfig.scripts.json scripts/render-check.tsx"
  },
  "dependencies": {
    "@driftwatch/core": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "^6.1.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.151.1"
  }
}
